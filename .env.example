# Public URL of the deployed site (used for canonical, Open Graph, sitemap and robots).
NEXT_PUBLIC_SITE_URL=https://your-portfolio.vercel.app

# Contact form (Resend). Leave empty to show the "email me directly" fallback.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# Optional: a sender on a domain verified in Resend. Defaults to onboarding@resend.dev.
CONTACT_FROM_EMAIL=
